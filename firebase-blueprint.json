{
  "entities": {
    "Project": {
      "title": "StoryProject",
      "description": "A StoryCast creative project containing storyboard scenes, characters, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "storyText": { "type": "string", "maxLength": 10000 },
        "visualStyle": { "type": "string", "maxLength": 100 },
        "scenesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with workspace connection preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User saved storyboard projects"
    }
  }
}
